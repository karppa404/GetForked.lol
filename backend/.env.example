# Copy to your shell or a secrets manager. Never commit real values.
RETRACE_ENV=development
RETRACE_HOST=127.0.0.1
RETRACE_PORT=8000
RETRACE_DATA_DIR=./data
RETRACE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Browser auth
RETRACE_DEV_AUTH=1                       # local only; refused in production / non-loopback
RETRACE_GOOGLE_CLIENT_ID=                # e.g. 1234.apps.googleusercontent.com
RETRACE_GOOGLE_ALLOWED_DOMAINS=          # optional, comma-separated

# Shared state: local (labeled dev fallback) or spacetimedb
RETRACE_STATE_BACKEND=local
RETRACE_SPACETIME_URI=
RETRACE_SPACETIME_DATABASE=
RETRACE_SPACETIME_TOKEN_FILE=            # preferred over RETRACE_SPACETIME_TOKEN

# Model endpoint (OpenAI-compatible). Loopback port forwards may omit the key.
RETRACE_LLM_PROVIDER=openai_compatible   # or offline_heuristic (dev, no credits)
RETRACE_LLM_BASE_URL=                    # e.g. http://127.0.0.1:8001/v1 via port forward
RETRACE_LLM_API_KEY=
RETRACE_LLM_API_KEY_FILE=
RETRACE_LLM_MODEL=                       # default model id for all stages
RETRACE_LLM_MODEL_WORKFLOW=
RETRACE_LLM_MODEL_NETWORK=
RETRACE_LLM_MODEL_RECONCILE=
RETRACE_LLM_MODEL_PUBLISH=
RETRACE_LLM_VISION=0                     # 1 for a VL model; frames capped by RETRACE_LLM_MAX_FRAMES

# Bounds and budget
RETRACE_LLM_MAX_CALLS_PER_JOB=8
RETRACE_LLM_MAX_RETRIES=2
RETRACE_LLM_TIMEOUT_S=60
RETRACE_LLM_MAX_OUTPUT_TOKENS=2048
RETRACE_LLM_MAX_TOKENS_PER_JOB=150000
RETRACE_LLM_MAX_JOB_SECONDS=600
RETRACE_LLM_MAX_FRAMES=4
RETRACE_LLM_MAX_CONCURRENCY=2
RETRACE_MAX_CONCURRENT_JOBS=1
RETRACE_BUDGET_TOTAL_TOKENS=3000000
RETRACE_BUDGET_USD=45
RETRACE_PRICE_INPUT_PER_MTOK=            # set both to enable the dollar stop
RETRACE_PRICE_OUTPUT_PER_MTOK=
