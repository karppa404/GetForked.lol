# Public, non-secret configuration only. NEXT_PUBLIC_* values are inlined into the client bundle.
# Never put tokens or API keys here.

# Retrace API base URL. When unset, localhost pages use http://127.0.0.1:8000 and any other host
# opens the Preview workspace (sample data only).
NEXT_PUBLIC_API_BASE_URL=

# Google OAuth web client ID for Google Identity Services. Pending configuration.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
